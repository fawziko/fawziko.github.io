# =============================================================================
# CommentDM — environment variables
# Copy this file to .env (never commit .env) and fill in your values.
# Values in .env take precedence over server defaults. The access token and
# account ID can also be saved from the dashboard; database values win.
# =============================================================================

# ---- Instagram Graph API ----------------------------------------------------
# Long-lived Facebook User Access Token (starts with EAAG...).
# Optional here: you can paste it in Settings → Instagram credentials instead.
INSTAGRAM_ACCESS_TOKEN=

# Instagram professional (Business/Creator) account ID, e.g. 17841400000000000.
# Get it from GET /me/accounts?fields=instagram_business_account
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Facebook App settings → Basic. Needed to validate X-Hub-Signature-256.
FACEBOOK_APP_SECRET=

# Any random string you also paste into Meta's webhook configuration.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_VERIFY_TOKEN=change-me-to-a-long-random-string

# ---- Optional: one-click token refresh (Settings page + scripts) ------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ---- Graph API tuning -------------------------------------------------------
INSTAGRAM_GRAPH_VERSION=v23.0
# GRAPH_API_BASE_URL=https://graph.facebook.com
# GRAPH_TIMEOUT_SECONDS=20

# ---- Application ------------------------------------------------------------
# SQLite path is relative to the application directory (commentdm/).
# Production with Postgres: postgresql+psycopg://user:pass@host:5432/commentdm
DATABASE_URL=sqlite:///./app.db

# Public HTTPS origin of this app (no trailing slash). Used to display the
# webhook callback URL and by Meta to reach the app.
PUBLIC_BASE_URL=

# Optional HTTP Basic protection for the dashboard and REST API.
# Enable BOTH in production so the credentials page is not public.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

APP_ENV=development
LOG_LEVEL=INFO

# Escape hatch for local webhook testing only. Keep false in production:
# with true, POST /webhook/instagram will accept unsigned payloads when
# FACEBOOK_APP_SECRET is missing.
ALLOW_UNSIGNED_WEBHOOKS=false
